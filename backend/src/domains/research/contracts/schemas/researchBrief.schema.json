{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finagent.local/schemas/research/researchBrief.v1.schema.json",
  "title": "ResearchBrief v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "asOf", "producer", "contractVersion", "inputDigest", "createdAt", "evidenceRefs", "title", "question", "theme", "entities", "constraints"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "asOf": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "minLength": 1 },
    "contractVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "inputDigest": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "title": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "theme": { "type": "string", "minLength": 1 },
    "entities": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "role"], "properties": { "id": { "type": "string" }, "ticker": { "type": "string" }, "role": { "type": "string" } }, "additionalProperties": false } },
    "constraints": { "type": "object" }
  }
}
