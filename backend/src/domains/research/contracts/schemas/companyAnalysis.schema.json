{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finagent.local/schemas/research/companyAnalysis.v1.schema.json",
  "title": "CompanyAnalysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "asOf", "producer", "contractVersion", "inputDigest", "createdAt", "evidenceRefs",
    "ticker", "businessModel", "driverBridge", "financialQuality", "valuation", "catalysts", "risks", "invalidation", "assumptionConflicts",
    "positioning", "growth", "quality", "impliedExpectations", "customerMap", "orderSwitching", "moatThreat", "management",
    "marketPerformance", "evidenceGaps", "surprises", "variantPerception", "sotp", "verdict", "conviction"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "asOf": { "type": "string", "format": "date-time" },
    "producer": { "const": "company-analyst" },
    "contractVersion": { "type": "string" },
    "inputDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "ticker": { "type": "string", "minLength": 1 },
    "businessModel": { "type": "object" },
    "driverBridge": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["industryDriverId", "companyExposure", "mechanism", "companyKpis", "financialLineItems", "valuationImpact", "evidenceRefs", "confidence"],
        "properties": {
          "industryDriverId": { "type": "string", "minLength": 1 },
          "companyExposure": { "enum": ["positive", "negative", "mixed", "none"] },
          "mechanism": { "type": "string", "minLength": 1 },
          "companyKpis": { "type": "array", "items": { "type": "string" } },
          "financialLineItems": { "type": "array", "items": { "type": "string" } },
          "valuationImpact": { "type": "string", "minLength": 1 },
          "evidenceRefs": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "financialQuality": { "type": "object" },
    "valuation": { "type": "object" },
    "catalysts": { "type": "array" },
    "risks": { "type": "array" },
    "invalidation": { "type": "array", "items": { "type": "string" } },
    "assumptionConflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "message", "industryAssumption", "companyAssumption", "evidenceRefs", "severity"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "industryAssumption": { "type": "string" },
          "companyAssumption": { "type": "string" },
          "evidenceRefs": { "type": "array", "items": { "type": "string" } },
          "severity": { "enum": ["info", "warning", "critical"] }
        },
        "additionalProperties": false
      }
    },
    "positioning": { "type": "string" },
    "growth": { "type": "string" },
    "quality": { "type": "string" },
    "impliedExpectations": { "type": "string" },
    "customerMap": { "type": "string" },
    "orderSwitching": { "type": "string" },
    "moatThreat": { "type": "string" },
    "management": { "type": "string" },
    "marketPerformance": { "type": "string" },
    "evidenceGaps": { "type": "array", "items": { "type": "string" } },
    "surprises": { "type": "array" },
    "variantPerception": { "type": "string" },
    "sotp": {},
    "verdict": { "type": "string", "minLength": 1 },
    "conviction": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
