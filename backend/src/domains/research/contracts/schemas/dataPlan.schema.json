{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finagent.local/schemas/research/dataPlan.v1.schema.json",
  "title": "DataPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "asOf", "producer", "contractVersion", "inputDigest", "createdAt", "evidenceRefs", "round", "questions", "entities", "timeWindows", "sourceStrategies", "freshnessPolicy", "gaps", "expectedArtifacts"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "asOf": { "type": "string", "format": "date-time" }, "producer": { "type": "string", "minLength": 1 }, "contractVersion": { "type": "string" }, "inputDigest": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" }, "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "round": { "type": "integer", "minimum": 1 },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questionId", "question", "material", "entityIds", "timeWindowId"],
        "properties": {
          "questionId": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "material": { "type": "boolean" },
          "entityIds": { "type": "array", "items": { "type": "string" } },
          "timeWindowId": { "type": "string", "minLength": 1 }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entityId", "entityType", "label"],
        "properties": {
          "entityId": { "type": "string", "minLength": 1 },
          "entityType": { "type": "string", "enum": ["company", "industry", "theme", "macro"] },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "timeWindows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timeWindowId", "label", "start", "end", "basis"],
        "properties": {
          "timeWindowId": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "start": { "type": "string", "format": "date-time" },
          "end": { "type": "string", "format": "date-time" },
          "basis": { "type": "string", "enum": ["historical", "current", "forward"] }
        }
      }
    },
    "sourceStrategies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["strategyId", "questionId", "priority", "entityIds", "timeWindowId", "providers", "tools", "primarySourceTypes", "fallbackSourceTypes"],
        "properties": {
          "strategyId": { "type": "string", "minLength": 1 },
          "questionId": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer", "minimum": 1 },
          "entityIds": { "type": "array", "items": { "type": "string" } },
          "timeWindowId": { "type": "string", "minLength": 1 },
          "providers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "tools": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "primarySourceTypes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "fallbackSourceTypes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "freshnessPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asOf", "rejectPublishedAfterAsOf", "unknownPublishedAt", "maxAgeDaysByEvidenceType"],
      "properties": {
        "asOf": { "type": "string", "format": "date-time" },
        "rejectPublishedAfterAsOf": { "type": "boolean" },
        "unknownPublishedAt": { "type": "string", "enum": ["use-observedAt-and-open-issue"] },
        "maxAgeDaysByEvidenceType": { "type": "object" }
      }
    },
    "gaps": { "type": "array", "items": { "type": "string" } },
    "expectedArtifacts": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
