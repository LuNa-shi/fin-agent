{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finagent.local/schemas/research/sourceDocument.v1.schema.json",
  "title": "SourceDocument v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceId", "contentHash", "uri", "provider", "title", "content", "publishedAt", "observedAt", "fetchedAt", "mimeType", "entityIds", "asOfSafe", "metadata"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sourceId": { "type": "string", "pattern": "^source:[a-f0-9]{64}$" },
    "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "uri": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "content": { "type": "string", "minLength": 1 },
    "publishedAt": { "type": "string", "format": "date-time" },
    "observedAt": { "type": "string", "format": "date-time" },
    "fetchedAt": { "type": "string", "format": "date-time" },
    "mimeType": { "type": "string", "minLength": 1 },
    "entityIds": { "type": "array", "items": { "type": "string" } },
    "asOfSafe": { "type": "boolean" },
    "metadata": { "type": "object" }
  }
}
