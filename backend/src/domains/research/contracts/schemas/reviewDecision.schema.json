{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finagent.local/schemas/research/reviewDecision.v1.schema.json",
  "title": "ReviewDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "asOf", "producer", "contractVersion", "inputDigest", "createdAt", "evidenceRefs", "converged", "cycle", "route", "remediation", "openIssues"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "asOf": { "type": "string", "format": "date-time" }, "producer": { "type": "string" }, "contractVersion": { "type": "string" }, "inputDigest": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" }, "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "converged": { "type": "boolean" }, "cycle": { "type": "integer", "minimum": 0, "maximum": 2 },
    "route": { "enum": ["publish", "data", "industry", "company", "report", "human-review"] },
    "remediation": { "type": "array", "items": { "type": "object" } }, "openIssues": { "type": "array", "items": { "type": "object" } }
  }
}
