{
  "$id": "citationLedger.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "asOf",
    "round",
    "inputDigest",
    "markerContract",
    "aliases",
    "sources",
    "evidenceItems",
    "ambiguousAliases",
    "navigationOnlyArtifacts"
  ],
  "properties": {
    "schemaVersion": { "const": "citation-ledger.v1" },
    "asOf": { "type": "string", "minLength": 1 },
    "round": { "type": "integer", "minimum": 1 },
    "inputDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "markerContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "estimate", "openIssue", "navigationArtifactsAreAtomicEvidence"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "estimate": { "type": "string", "minLength": 1 },
        "openIssue": { "type": "string", "minLength": 1 },
        "navigationArtifactsAreAtomicEvidence": { "const": false }
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "sourceId", "marker"],
        "properties": {
          "alias": { "type": "string", "minLength": 1 },
          "sourceId": { "type": "string", "pattern": "^source:[a-f0-9]{64}$" },
          "marker": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "marker", "provider", "title", "uri", "publishedAt", "entityIds", "evidenceIds"],
        "properties": {
          "sourceId": { "type": "string", "pattern": "^source:[a-f0-9]{64}$" },
          "marker": { "type": "string", "minLength": 1 },
          "provider": { "type": "string" },
          "title": { "type": "string" },
          "uri": { "type": "string" },
          "publishedAt": { "type": "string", "minLength": 1 },
          "entityIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "evidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^evidence:[a-f0-9]{64}$" } }
        }
      }
    },
    "evidenceItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "marker", "sourceId", "statement", "evidenceType", "confidence", "locator"],
        "properties": {
          "evidenceId": { "type": "string", "pattern": "^evidence:[a-f0-9]{64}$" },
          "marker": { "type": "string", "minLength": 1 },
          "sourceId": { "type": "string", "pattern": "^source:[a-f0-9]{64}$" },
          "statement": { "type": "string", "minLength": 1 },
          "value": {},
          "unit": { "type": "string" },
          "period": { "type": "string" },
          "evidenceType": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "locator": { "type": "object" }
        }
      }
    },
    "ambiguousAliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "sourceIds"],
        "properties": {
          "alias": { "type": "string", "minLength": 1 },
          "sourceIds": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^source:[a-f0-9]{64}$" }
          }
        }
      }
    },
    "navigationOnlyArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "labels"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "labels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
