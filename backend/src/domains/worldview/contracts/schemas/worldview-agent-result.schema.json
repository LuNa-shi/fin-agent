                    },
                    "changed": {
                      "type": "array",
                      "maxItems": 256,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    },
                    "added": {
                      "type": "array",
                      "maxItems": 256,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    },
                    "removed": {
                      "type": "array",
                      "maxItems": 256,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "claimActions": {
      "type": "array",
      "maxItems": 100,
      "items": {}
    }
  }
}
