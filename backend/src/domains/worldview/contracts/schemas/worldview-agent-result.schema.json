{
  "$id": "worldview-agent-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "worldview",
    "claimActions"
  ],
  "properties": {
    "contract": {
      "type": "string",
      "const": "worldview-agent-result.v1"
    },
    "worldview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "baseWorldviewVersionId",
        "rationale",
        "package"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "KEEP",
            "UPDATE"
          ]
        },
        "baseWorldviewVersionId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
            }
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "package": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "asOf",
                "narrativeMarkdown",
                "causalRelationships",
                "evidence",
                "counterEvidence",
                "investmentImplications",
                "coverage",
                "updateSummary"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "asOf": {
                  "type": "string",
                  "format": "date-time"
                },
                "narrativeMarkdown": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500000
                },
                "causalRelationships": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1000,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "relationshipId",
                      "cause",
                      "effect",
                      "mechanism",
                      "confidence",
                      "evidence",
                      "counterEvidence"
                    ],
                    "properties": {
                      "relationshipId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
                      },
                      "cause": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "effect": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "mechanism": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 10000
                      },
                      "confidence": {
                        "type": "string",
                        "enum": [
                          "low",
                          "medium",
                          "high"
                        ]
                      },
                      "evidence": {
                        "type": "array",
                        "maxItems": 1000,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "reportVersionId",
                            "contentDigest"
                          ],
                          "properties": {
                            "reportVersionId": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
                            },
                            "contentDigest": {
                              "type": "string",
                              "pattern": "^sha256:[a-f0-9]{64}$"
                            }
                          }
                        }
                      },
                      "counterEvidence": {
                        "type": "array",
                        "maxItems": 1000,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "reportVersionId",
                            "contentDigest"
                          ],
                          "properties": {
                            "reportVersionId": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
                            },
                            "contentDigest": {
                              "type": "string",
                              "pattern": "^sha256:[a-f0-9]{64}$"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 10000,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "reportVersionId",
                      "contentDigest",
                      "kind",
                      "summary"
                    ],
                    "properties": {
                      "reportVersionId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
                      },
                      "contentDigest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      },
                      "kind": {
                        "type": "string",
                        "const": "supporting"
                      },
                      "summary": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 10000
                      }
                    }
                  }
                },
                "counterEvidence": {
                  "type": "array",
                  "maxItems": 10000,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "reportVersionId",
                      "contentDigest",
                      "kind",
                      "summary"
                    ],
                    "properties": {
                      "reportVersionId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
                      },
                      "contentDigest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      },
                      "kind": {
                        "type": "string",
                        "const": "counter"
                      },
                      "summary": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 10000
                      }
                    }
                  }
                },
                "investmentImplications": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1000,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "theme",
                      "implication",
                      "horizon",
                      "confidence"
                    ],
                    "properties": {
                      "theme": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      "implication": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 10000
                      },
                      "horizon": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      "confidence": {
                        "type": "string",
                        "enum": [
                          "low",
                          "medium",
                          "high"
                        ]
                      }
                    }
                  }
                },
                "coverage": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "overviewIds",
                    "reportVersionIds",
                    "selectedFullReadReportVersionIds"
                  ],
                  "properties": {
                    "overviewIds": {
                      "type": "array",
                      "maxItems": 10000,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
                      }
                    },
                    "reportVersionIds": {
                      "type": "array",
                      "maxItems": 10000,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
                      }
                    },
                    "selectedFullReadReportVersionIds": {
                      "type": "array",
                      "maxItems": 10000,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
                      }
                    }
                  }
                },
                "updateSummary": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "retained",
                    "changed",
                    "added",
                    "removed"
