{
  "$id": "core-worldview.input.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "asOf",
    "capabilityScopeId",
    "baseWorldviewVersionId",
    "frozenRange",
    "overviewManifestDigest",
    "overviews",
    "currentClaims",
    "approvedCapabilities"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "capabilityScopeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
    },
    "baseWorldviewVersionId": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        }
      ]
    },
    "frozenRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priorProcessedReceiptCount",
        "startAdmissionSequence",
        "endAdmissionSequence"
      ],
      "properties": {
        "startAdmissionSequence": {
          "type": "integer",
          "minimum": 1
        },
        "endAdmissionSequence": {
          "type": "integer",
          "minimum": 1
        },
        "priorProcessedReceiptCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "overviewManifestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "overviews": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "admissionSequence",
          "reportVersionId",
          "contentDigest",
          "fingerprint",
          "overviewId",
          "overviewDigest",
          "overviewContentDigest",
          "overview"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "admissionSequence": {
            "type": "integer",
            "minimum": 1
          },
          "reportVersionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
          },
          "contentDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "overviewId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
          },
          "overviewDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "overviewContentDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "overview": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reportVersionId",
              "contentDigest",
              "summary",
              "keyThemes",
              "entities",
              "materialDevelopments",
              "uncertainties"
            ],
            "properties": {
              "reportVersionId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
              },
              "contentDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "keyThemes": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "entities": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "type",
                    "tickers"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "tickers": {
                      "type": "array",
                      "maxItems": 32,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 32
                      }
                    }
                  }
                }
              },
              "materialDevelopments": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "uncertainties": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              }
            }
          }
        }
      }
    },
    "approvedCapabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "worldview_read_current",
          "worldview_enumerate_overviews",
          "worldview_read_report_version",
          "worldview_search_claims"
        ]
      }
    },
    "currentClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claimId",
          "version",
          "assertion"
        ],
        "properties": {
          "claimId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "assertion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[^\\r\\n]+$"
          }
        }
      }
    }
  }
}
