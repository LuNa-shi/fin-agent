{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finagent.local/schemas/agents/deal-ladder-ranking.output.v1.schema.json",
  "title": "Deal Ladder Ranking Output v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["ranking"],
  "properties": {
    "ranking": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["ticker"],
        "properties": {
          "ticker": { "type": "string" },
          "rank": { "type": "number", "minimum": 1 },
          "note": { "type": "string" }
        }
      }
    }
  }
}
