# 复制为 backend/.env 并填入真实值。该文件只列 key 名，绝不提交真实密钥。
# LLM providers
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=gpt-5.6-sol
# OpenAI-compatible / CLI Proxy API 示例：model id 原样使用；reasoning level 默认 `high`。
OPENAI_COMPATIBLE_REASONING_LEVEL=high
DEEPSEEK_API_KEY=
# 可选 provider 只有 openai-compatible / deepseek；所选 provider 缺少凭证时 fail closed，不自动切换。
DEFAULT_PROVIDER=openai-compatible
DEEPSEEK_MODEL=deepseek-v4-pro
# small/main/reflection 留空表示跟随 DEFAULT_PROVIDER；每层都可显式覆盖。
SMALL_PROVIDER=
SMALL_MODEL=
MAIN_PROVIDER=
MAIN_MODEL=
REFLECTION_PROVIDER=
REFLECTION_MODEL=

# 数据源
FMP_API_KEY=
PERPLEXITY_API_KEY=
TAVILY_API_KEY=
FRED_API_KEY=

# Canonical Worldview / Report Library resident authorities
REPORT_LIBRARY_DIR=
CANONICAL_WORLDVIEW_DIR=
CLAIM_LIBRARY_DIR=
WORLDVIEW_MAX_OVERVIEWS_PER_RUN=100
WORLDVIEW_MAX_OVERVIEW_BYTES_PER_RUN=96000
WORLDVIEW_MAX_CONTEXT_TOKENS_PER_RUN=32000
WORLDVIEW_MAX_OUTPUT_TOKENS_PER_RUN=32768
WORLDVIEW_MAX_WALL_CLOCK_MS_PER_RUN=600000
WORLDVIEW_MAX_TOOL_CALLS_PER_RUN=256

# 服务
PORT=8787

# 网络：api.perplexity.ai 在部分网络环境被 DNS 污染/阻断，需经本地代理（如 Clash: http://127.0.0.1:7897）
PPLX_PROXY=
